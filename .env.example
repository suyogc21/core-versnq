# Copy to .env (make setup does this). Never commit .env.
ENVIRONMENT=dev

# Postgres (docker-compose, host port 5433)
# Superuser: container admin only, never used by the app.
POSTGRES_PASSWORD=changeme
# versnq_owner runs migrations; versnq_app runs the app (cannot bypass RLS).
OWNER_DB_PASSWORD=changeme-owner
APP_DB_PASSWORD=changeme-app
DATABASE_URL=postgresql+asyncpg://versnq_app:changeme-app@localhost:5433/versnq
MIGRATION_DATABASE_URL=postgresql+asyncpg://versnq_owner:changeme-owner@localhost:5433/versnq
# Connections per app / worker process (pool + overflow at peaks). Keep the total across all
# processes under Postgres max_connections (default 100), or put PgBouncer in front.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
TEST_DATABASE_URL=postgresql+asyncpg://versnq_app:changeme-app@localhost:5433/versnq_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://versnq_owner:changeme-owner@localhost:5433/versnq_test

# Auth: JWT_SECRET must be at least 32 characters; generate with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-min
# Encrypts 2FA secrets at rest (Fernet key). Generate with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=replace-with-a-fernet-key
# Fernet key for company secrets: payment gateway keys and mailbox passwords (step 6).
# Required in production; elsewhere the 2FA key is used if this is empty.
SECRETS_ENCRYPTION_KEY=replace-with-a-different-fernet-key
# Client workspaces live at <slug>.<BASE_DOMAIN>. Dev: localhost (acme.localhost:3000).
# Production: core.versnq.in (Decision log #20).
BASE_DOMAIN=localhost
# true only behind a proxy that overwrites X-Forwarded-Host (Next dev server, nginx)
TRUST_PROXY_HEADERS=true

# Redis (docker-compose, host port 6380)
REDIS_URL=redis://localhost:6380/0

# Dev/e2e only: save outgoing emails (invites, password resets) as JSON files in this folder
# instead of printing them in the API log. Ignored in production.
# # Sequence emails: test (kept in Core, nothing sent) or mailbox (the company's own mailbox)
EMAIL_SENDER=test
MAIL_OUTBOX_DIR=../.outbox
# Newsletters through Postmark's broadcast stream: test (nothing leaves Core) or live
POSTMARK_MODE=test
POSTMARK_SERVER_TOKEN=
POSTMARK_BROADCAST_STREAM=broadcast
# Dev only: read connected inboxes from <dir>/<address>/<folder>/<uid>.eml instead of a real
# IMAP server (step 9b-3). Leave unset to use the real mail servers. Ignored in production.
# MAILBOX_TEST_DIR=../.mailboxes
# Copy-in addresses (step 9b-2): <company>-<token>@INBOUND_EMAIL_DOMAIN. Set LIVE to true once
# inbound mail for that domain reaches Core (Amazon SES at go-live); until then screens say so.
INBOUND_EMAIL_DOMAIN=copy.versnq.in
INBOUND_EMAIL_LIVE=false
# Official WhatsApp number (step 10b): test (nothing sent to Meta) or meta (the Cloud API).
WHATSAPP_SENDER=test

# Uploaded files (documents, KYC, later invoice PDFs) are stored on this server's disk
# (Decision log #29). Relative paths are from the backend folder. Back it up nightly.
# FILES_DIR=var/files

# Dev demos only: invented demo accounts (emails ending in .demo or @demo.versnq.in) skip
# the 2FA setup step, so a presenter can sign in as Owner/Admin/staff without an
# authenticator app. Real people always need 2FA. The API refuses to start with this on in prod.
DEMO_SKIP_2FA=false

# Core's own emails (invites, password resets) through a mailbox (SMTP). Leave empty in dev:
# they go to MAIL_OUTBOX_DIR or the log.
# SYSTEM_SMTP_HOST=
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_SECURITY=starttls
# SYSTEM_SMTP_USERNAME=
# SYSTEM_SMTP_PASSWORD=
# SYSTEM_EMAIL_FROM=
# Unexpected errors are emailed here, once an hour per kind (go-live G-2); empty: log only
# ALERT_EMAIL=
# ACE's console address (C13: Sign in with Core); empty: no "Open ACE"
# ACE_CONSOLE_URL=http://localhost:3100
# Phone notifications (web push, C2); empty: off
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Calls with a company's own Twilio (C3): test (default here) never reaches Twilio; live on the server
# TWILIO_MODE=test
