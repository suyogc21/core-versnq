# Copy to .env.prod on the server (never commit it). Generate every secret fresh:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"            passwords
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"            JWT_SECRET
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  Fernet keys
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY=
BASE_DOMAIN=core.versnq.in
# mailbox: emails go out through each company's / user's own connected mailbox
EMAIL_SENDER=mailbox
INBOUND_EMAIL_DOMAIN=copy.versnq.in
INBOUND_EMAIL_LIVE=false
# test until Meta verifies the business; then meta
WHATSAPP_SENDER=test
# true lets `python -m app.platform.demo --server` add the invented demo companies
ALLOW_DEMO_DATA=false
# Core's own emails (invites, password resets). Empty: written to the backend log only.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURITY=starttls
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_EMAIL_FROM=
SYSTEM_EMAIL_FROM_NAME=Versnq
# Unexpected errors (500s, failed worker jobs) are emailed here, once an hour per kind (G-2)
ALERT_EMAIL=
